# The assistant's models go through the AI gateway on this Cairn server: users
# sign in with Cairn, and it adds the org's provider credential server-side
# (src/chat/cairn.js). Empty: the chat asks for the user's own key instead.
VITE_CAIRN_SERVER=https://wb-sandbox.internationalmapping.com
# Which of the user's AI endpoints to use, by id or name; empty: the first.
VITE_CAIRN_AI_ENDPOINT=
